{
  "manifest_version": 3,
  "name": "UI Coach — ИИ-подсказки по интерфейсам",
  "version": "0.1.0",
  "description": "Спросите, как пользоваться любым инструментом (онлайн-версия в браузере), и получите пошаговую инструкцию с подсветкой нужной кнопки прямо на реальном интерфейсе.",
  "minimum_chrome_version": "114",
  "permissions": ["storage", "sidePanel", "scripting", "tabs", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "UI Coach"
  },
  "side_panel": {
    "default_path": "src/sidepanel/panel.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/coach.js"],
      "css": ["src/content/coach.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
